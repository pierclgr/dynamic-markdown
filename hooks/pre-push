#!/usr/bin/env bash
# pre-push hook: docstring-check and test the whole repo
# aborts on docstring or test failures; does not edit files or create commits

set -e

REPO=$(git rev-parse --show-toplevel)
VENV=$REPO/.venv/bin
cd "$REPO"

# docstring completeness across the whole repo
"$VENV/ruff" check --select=D,DOC --preview src/ tests/

# tests
"$VENV/python" -m pytest tests/ -v

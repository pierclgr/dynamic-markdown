#!/usr/bin/env bash
# pre-commit hook: auto-fix lint and formatting before creating a commit
# stages tracked fixes under src/ and tests/ so they are included in the commit

set -e

REPO=$(git rev-parse --show-toplevel)
VENV=$REPO/.venv/bin
cd "$REPO"

# auto-fix pass - capture exit codes, do not abort before staging fixes
ruff_fix_exit=0
"$VENV/ruff" check --fix src/ tests/ || ruff_fix_exit=$?

docf_exit=0
"$VENV/docformatter" --in-place --recursive --wrap-summaries 88 --wrap-descriptions 88 src/ tests/ || docf_exit=$?
if [ "$docf_exit" -ne 0 ] && [ "$docf_exit" -ne 3 ]; then
    echo "pre-commit: docformatter failed with exit $docf_exit" >&2
    exit "$docf_exit"
fi

"$VENV/ruff" format src/ tests/

if ! git diff --quiet -- src/ tests/; then
    git add -u src/ tests/
    echo "" >&2
    echo "pre-commit: staged auto-fixes under src/ and tests/." >&2
    echo "" >&2
fi

if [ "$ruff_fix_exit" -ne 0 ]; then
    exit "$ruff_fix_exit"
fi
